# --- Application ---
APP_ENV=local
LOG_LEVEL=INFO

# --- Auth ---
# ОБЯЗАТЕЛЬНО переопределить в проде: этим ключом подписываются токены.
SECRET_KEY=dev-only-insecure-secret-change-me
ACCESS_TOKEN_TTL_S=28800

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=local_knowledge_rag
POSTGRES_USER=rag
POSTGRES_PASSWORD=change-me

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=knowledge_chunks

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
# true — выполнять задачи прямо в процессе приложения, без отдельного воркера
CELERY_TASK_ALWAYS_EAGER=false

# --- Local inference ---
OLLAMA_URL=http://localhost:11434
# Адрес Ollama для сервисов в Docker Compose (localhost внутри контейнера
# указывал бы на сам контейнер).
DOCKER_OLLAMA_URL=http://host.docker.internal:11434
VLLM_URL=http://localhost:8000
# ollama | vllm
INFERENCE_PROVIDER=ollama
LLM_MODEL=qwen3:4b
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# --- Reranking ---
RERANK_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATES=30
RERANK_TOP_K=8

# --- Retrieval ---
HYBRID_RETRIEVAL_ENABLED=true

# --- Честный отказ ---
# Ответ, не сославшийся ни на один действительный фрагмент, проверить нечем,
# поэтому по умолчанию он считается отсутствием ответа.
NO_ANSWER_REQUIRE_CITATIONS=true
# Порог релевантности выключен: он живёт в шкале конкретной embedding-модели,
# и зашитое число врало бы при её замене. Подбирается прогоном
# scripts/evaluate_retrieval.py, где видно цену — ложные срабатывания падают
# вместе с Recall.
# NO_ANSWER_MIN_SCORE=0.8

# --- Hardware ---
# HARDWARE_PROFILE_OVERRIDE=performance

# Автоматическая установка Ollama из приложения. Выключена по умолчанию:
# это запуск системной команды по HTTP-запросу. При false приложение
# отдаёт готовую команду, а выполняет её пользователь сам.
RUNTIME_INSTALL_ENABLED=false

# --- Model ring (кольцевой fallback Qwen -> Gemma -> Llama) ---
MODEL_RING_ENABLED=true
MODEL_RING_MAX_ATTEMPTS=3
MODEL_RING_TIMEOUT_BUDGET_S=45.0
MODEL_RING_COOLDOWN_S=60.0
MODEL_RING_FAILURE_THRESHOLD=2
